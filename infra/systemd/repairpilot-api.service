[Unit]
Description=RepairPilot API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/repairpilot
EnvironmentFile=/home/ubuntu/.config/repairpilot/runtime.env
ExecStart=/home/ubuntu/repos/repairpilot/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/repos/repairpilot/runtime /home/ubuntu/repos/repairpilot/.git
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
