# Non-secret local defaults. Copy to a private runtime environment file.
REPAIRPILOT_MODE=live
REPAIRPILOT_RUNTIME_DIR=runtime
REPAIRPILOT_REPO_ROOT=.
REPAIRPILOT_PUBLIC_URL=http://127.0.0.1:8766
DATAHUB_FRONTEND_URL=http://127.0.0.1:9002
DATAHUB_GMS_URL=http://127.0.0.1:8080
DATAHUB_GMS_TOKEN=
DATAHUB_MCP_COMMAND=.venv/bin/mcp-server-datahub
DATAHUB_MCP_PACKAGE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Production uses a systemd encrypted credential, not a plaintext env value.
DEEPSEEK_API_KEY_FILE=/run/credentials/repairpilot-api.service/deepseek_api_key
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=repairpilot
POSTGRES_USER=repairpilot
POSTGRES_PASSWORD=repairpilot-local-only
GITHUB_REPOSITORY=TianChen17/repairpilot
GITHUB_CANONICAL_PR_URL=https://github.com/TianChen17/repairpilot/pull/1
